# Docker Compose deployment credentials (use strong random values).
POSTGRES_PASSWORD=

# PostgreSQL production mode: set DATABASE_URL to enable PostgreSQL.
# Keep it empty for the local SQLite mode.
DATABASE_URL=
PG_POOL_MAX=10

# SQLite development mode only.
DATABASE_PATH=./data/mangongchang.sqlite

# Uploaded/generated images are stored on this persistent local directory.
# The directory must be backed up or mounted on persistent storage in deployments.
LOCAL_STORAGE_DIR=./data/assets
PORT=4173
# Set HOST=0.0.0.0 only when running inside a container/reverse-proxy deployment.
HOST=127.0.0.1
MAX_REQUEST_MB=20
MAX_IMAGE_UPLOAD_MB=10
AUTH_PASSWORD=
AUTH_SESSION_DAYS=7

# OpenAI-compatible chat completions.
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# OpenAI-compatible image generation.
IMAGE_PROVIDER=mock
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_SIZE=1024x1536
