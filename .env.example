# Copy to .env and fill in provider settings. Keep .env private.
# OpenAI-compatible Chat Completions endpoint; base URL usually ends with /v1.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# OpenAI-compatible image generation endpoint; base URL usually ends with /v1.
IMAGE_PROVIDER=openai-compatible
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_SIZE=1024x1536
