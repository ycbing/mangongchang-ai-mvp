# Copy to .env. Do not commit real secrets.
DATABASE_PATH=./data/mangongchang.sqlite
LOCAL_STORAGE_DIR=./data/assets
MAX_REQUEST_MB=20
MAX_IMAGE_UPLOAD_MB=10
AUTH_PASSWORD=
AUTH_SESSION_DAYS=7

# OpenAI-compatible chat completions (leave mock by omitting these values).
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# OpenAI-compatible image generation.
IMAGE_PROVIDER=mock
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_SIZE=1024x1536
