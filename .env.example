# Docker Compose deployment credentials (use strong random values).
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# PostgreSQL is required in production. Keep empty only for local SQLite development.
DATABASE_URL=
PG_POOL_MAX=10

# Optional external Redis; empty keeps the local in-process worker.
REDIS_URL=
JOB_CONCURRENCY=2
JOB_DISPATCH_INTERVAL_MS=5000

# SQLite development mode only.
DATABASE_PATH=./data/mangongchang.sqlite

# PostgreSQL backup output; ignored under data/ by default.
BACKUP_DIR=./data/backups
# Optional external 32-byte key file for backup:seal/backup:unseal; keep the key separate from backup copies.
BACKUP_KEY_FILE=
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETRY_SECONDS=300
BACKUP_KEEP=14
BACKUP_RETENTION_DAYS=90

# Local image directory (used when S3_BUCKET is empty).
LOCAL_STORAGE_DIR=./data/assets

# Optional S3-compatible image storage. Keep S3_BUCKET empty for local files.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
PORT=4173
# Set HOST=0.0.0.0 only when running inside a container/reverse-proxy deployment.
HOST=127.0.0.1
MAX_REQUEST_MB=20
MAX_IMAGE_UPLOAD_MB=10
# Production requires a random password with at least 16 characters.
AUTH_PASSWORD=
AUTH_SESSION_DAYS=7

# OpenAI-compatible chat completions.
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# OpenAI-compatible image generation.
IMAGE_PROVIDER=mock
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_SIZE=1024x1536
